---
const QUESTIONS = [
  { q: 'Which Macs?', a: 'Any Mac on macOS 26 or later. Macs with a notch get the full effect; others get a slim pill at the top of the screen.' },
  { q: 'Which calendars work?', a: 'Anything in macOS Calendar: iCloud, Google, Exchange and more. Add a Google or Microsoft account in System Settings › Internet Accounts and Ake sees it.' },
  { q: 'Which meeting apps can I join?', a: 'Zoom, Google Meet, Microsoft Teams, FaceTime, Webex and six more. Join opens the link from the meeting itself.' },
  { q: 'What does it cost?', a: 'Ake is free.' },
  { q: 'Where does my calendar data go?', a: 'Nowhere. Ake reads your calendars on your Mac and sends nothing anywhere else: no account, no servers, no analytics.' },
] as const
---

<section id="faq" class="section">
  <div class="wrap">
    <p class="eyebrow">FAQ</p>
    <h2>Questions</h2>
    <div class="list">
      {QUESTIONS.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list { margin-top: 32px; max-width: 46rem; border-top: 1px solid var(--hairline); }
  details { border-bottom: 1px solid var(--hairline); }
  summary { padding: 18px 0; font-size: 18px; font-weight: 600; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--cream-3); transition: rotate var(--dur-hover) ease-out; }
  details[open] summary::after { rotate: 45deg; }
  details p { padding-bottom: 18px; color: var(--cream-2); }
</style>
