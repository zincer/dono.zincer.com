---
import MiniNotch from '../components/MiniNotch.astro'
import Base from '../layouts/Base.astro'
---

<Base title="Ake social image" description="Source for og.png." noindex>
  <div class="og">
    <div class="bar"><div class="notch"><MiniNotch lead="-04:12" tone="upcoming" title="Design review" label="Ake notch counting down" /></div></div>
    <h1>Your day, in the notch.</h1>
    <p><svg class="mark" viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><defs><clipPath id="ake-disc-36"><circle cx="50" cy="50" r="35.4"/></clipPath></defs><g clip-path="url(#ake-disc-36)"><rect y="0" width="100" height="52.7" fill="#f6a13a"/><rect y="57.9" width="100" height="5.2" fill="#ef6f3c"/><rect y="68.4" width="100" height="5.2" fill="#d9434f"/><rect y="78.9" width="100" height="10" fill="#a8336b"/></g></svg>Ake · ake.to</p>
  </div>
</Base>

<style>
  .og { width: 1200px; height: 630px; display: grid; justify-items: center; align-content: center; gap: 36px; background: radial-gradient(120% 90% at 50% 0%, #3b3550, var(--canvas) 70%); overflow: hidden; }
  .bar { position: absolute; top: 0; left: 0; right: 0; height: 64px; background: rgb(0 0 0 / 0.28); }
  .notch { scale: 2; transform-origin: top center; }
  h1 { margin-top: 40px; font-size: 92px; font-weight: 650; letter-spacing: -0.035em; }
  p { display: flex; align-items: center; gap: 12px; color: var(--cream-2); font-size: 28px; }
  .mark { display: block; flex: none; }
</style>
