---
const LINKS = [
  { href: '/#notch', label: 'Notch' },
  { href: '/#privacy', label: 'Privacy' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/next', label: 'What’s next' },
]
---

<header class="nav">
  <nav class="wrap inner" aria-label="Main">
    <a class="brand" href="/"><svg class="mark" viewBox="0 0 100 100" width="20" height="20" aria-hidden="true"><defs><clipPath id="ake-disc-20"><circle cx="50" cy="50" r="35.4"/></clipPath></defs><g clip-path="url(#ake-disc-20)"><rect y="0" width="100" height="52.7" fill="#f6a13a"/><rect y="57.9" width="100" height="5.2" fill="#ef6f3c"/><rect y="68.4" width="100" height="5.2" fill="#d9434f"/><rect y="78.9" width="100" height="10" fill="#a8336b"/></g></svg>Ake</a>
    <ul class="links">
      {LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
    <a class="cta" href="/#get">Get Ake</a>
  </nav>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 10; background: rgb(9 9 8 / 0.72); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid var(--hairline); }
  .inner { height: 56px; display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 650; text-decoration: none; }
  .mark { display: block; flex: none; }
  .links { list-style: none; padding: 0; margin-left: auto; display: none; gap: 24px; font-size: 14px; }
  .links a { color: var(--cream-2); text-decoration: none; transition: color var(--dur-hover) ease-out; }
  .links a:hover { color: var(--cream); }
  .cta { margin-left: auto; padding: 6px 14px; border-radius: 999px; background: var(--accent); color: var(--on-accent); font-size: 14px; font-weight: 600; text-decoration: none; }
  @media (min-width: 720px) { .links { display: flex; } .cta { margin-left: 0; } }
</style>
