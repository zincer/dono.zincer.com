---
import MiniNotch from './MiniNotch.astro'

const STATES = [
  { lead: '14:00', tone: 'dot', title: 'Design review', label: 'Idle notch: Design review at 14:00', caption: 'Idle: your next start time' },
  { lead: '-04:12', tone: 'upcoming', title: 'Design review', label: 'Countdown: 4 minutes 12 seconds to Design review', caption: 'Countdown: orange, then red in the last three minutes' },
  { lead: '+00:04', tone: 'started', title: 'Design review', label: 'Started: Design review began 4 seconds ago', caption: 'Started: green, counting up' },
  { lead: '12:04', tone: 'focus', title: 'Write the brief', label: 'Focus: 12 minutes on Write the brief', caption: "Focus: your task's timer" },
] as const
---

<section id="notch" class="section">
  <div class="wrap">
    <p class="eyebrow">The notch</p>
    <h2>Never miss the start.</h2>
    <p class="lede">
      The next start time sits beside the camera. Minutes before, it becomes a countdown, red in the last three. Hover for the details and a one-click Join for Zoom, Google Meet, Microsoft Teams, FaceTime, Webex and six more.
    </p>
    <ul class="strip">
      {STATES.map((state) => (
        <li>
          <div class="screen"><MiniNotch lead={state.lead} tone={state.tone} title={state.title} label={state.label} /></div>
          <p>{state.caption}</p>
        </li>
      ))}
    </ul>
    <p class="note">No notch? Dono draws a slim pill at the top of the screen instead.</p>
  </div>
</section>

<style>
  .strip { list-style: none; padding: 0; margin-top: 48px; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .strip { grid-template-columns: repeat(4, 1fr); } }
  .screen { height: 96px; border-radius: 12px; overflow: hidden; background: radial-gradient(120% 120% at 50% 0%, #3b3550, #14131a 75%); }
  .strip p { margin-top: 10px; color: var(--cream-2); font-size: 14px; }
  .note { margin-top: 24px; color: var(--cream-3); font-size: 14px; }
</style>
