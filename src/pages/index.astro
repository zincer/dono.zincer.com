---
import ComingNext from '../components/ComingNext.astro'
import Faq from '../components/Faq.astro'
import Focus from '../components/Focus.astro'
import Footer from '../components/Footer.astro'
import GetAke from '../components/GetAke.astro'
import Hero from '../components/Hero.astro'
import Nav from '../components/Nav.astro'
import NotchStrip from '../components/NotchStrip.astro'
import Phone from '../components/Phone.astro'
import Planner from '../components/Planner.astro'
import Privacy from '../components/Privacy.astro'
import Base from '../layouts/Base.astro'
---

<Base
  title="Ake · Your day, in the notch"
  description="Ake turns the notch on your Mac into a calm countdown to your next meeting, with a planner that fits your tasks around your calendar."
>
  <Nav />
  <main>
    <Hero />
    <NotchStrip />
    <Planner />
    <Focus />
    <Phone />
    <Privacy />
    <ComingNext />
    <Faq />
    <section id="get" class="section closing">
      <div class="wrap">
        <h2>Get Ake.</h2>
        <GetAke />
        <a class="next-link" href="/next">What’s next →</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .closing .wrap { display: grid; justify-items: center; gap: 28px; text-align: center; }
  .next-link { color: var(--cream-2); font-size: 14px; }
</style>
