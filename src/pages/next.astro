---
import Badge from '../components/Badge.astro'
import ComingNext from '../components/ComingNext.astro'
import Focus from '../components/Focus.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import Planner from '../components/Planner.astro'
import Signup from '../components/Signup.astro'
import Base from '../layouts/Base.astro'
---

<Base
  title="What’s coming · Ake"
  description="What we’re building next for Ake: tasks and planning around your meetings, a focus timer in the notch, and Ake on iPhone."
>
  <Nav />
  <main>
    <section class="intro wrap">
      <h1>What’s coming.</h1>
      <p class="lede">Ake 1.0 is the countdown to your next meeting. This is what we’re building next. None of it is in the app yet.</p>
    </section>
    <Planner />
    <Focus />
    <ComingNext />
    <section id="iphone" class="section">
      <div class="wrap">
        <p class="eyebrow">iPhone <Badge /></p>
        <h2>The countdown on your iPhone.</h2>
        <p class="lede">A companion app with the same countdown, in the Dynamic Island, and a one-tap Join.</p>
      </div>
    </section>
    <section id="waitlist" class="section closing">
      <div class="wrap">
        <h2>Hear when it ships.</h2>
        <Signup id="signup-waitlist" />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .intro { padding-top: clamp(48px, 9vw, 112px); padding-bottom: clamp(40px, 6vw, 72px); }
  h1 { font-size: clamp(44px, 8vw, 88px); font-weight: 650; letter-spacing: -0.035em; line-height: 1; }
  .closing .wrap { display: grid; justify-items: center; gap: 28px; text-align: center; }
</style>
