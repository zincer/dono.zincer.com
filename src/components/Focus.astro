---
import MiniNotch from './MiniNotch.astro'
---

<section id="focus" class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Focus</p>
      <h2>One task. One timer.</h2>
      <p class="lede">
        Focus a task and its timer moves into the notch. Run past the estimate and it turns amber, never red. Finish, and Ake offers the next one.
      </p>
    </div>
    <div class="art">
      <div class="screen"><MiniNotch lead="31:02" tone="over" title="Write the brief" label="Focus timer at 31 minutes 2 seconds, past the 30-minute estimate" /></div>
      <div class="card" aria-hidden="true">
        <span class="name">Write the brief</span>
        <span class="progress tabular">32m of 30m</span>
        <span class="buttons"><span class="btn">Pause</span><span class="btn done">Done</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .art { display: grid; gap: 16px; }
  .screen { height: 120px; border-radius: 14px; overflow: hidden; background: radial-gradient(120% 120% at 50% 0%, #3b3550, #14131a 75%); }
  .card { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding: 14px 16px; border-radius: 12px; background: var(--surface-quiet); box-shadow: inset 0 0 0 1px var(--hairline); }
  .name { font-weight: 600; }
  .progress { color: var(--timer-upcoming); font-size: 14px; }
  .buttons { margin-left: auto; display: flex; gap: 8px; }
  .btn { padding: 4px 12px; border-radius: 999px; background: var(--surface-control); font-size: 13px; font-weight: 600; }
  .done { background: var(--accent); color: var(--on-accent); }
</style>
